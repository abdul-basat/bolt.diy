{
  "$schema": "./app/lib/config/schema.json",
  "memory": {
    "enabled": true,
    "storageBackend": "indexeddb",
    "maxItems": 1000,
    "retentionDays": 30,
    "autoCleanup": true
  },
  "github": {
    "enabled": false,
    "autoCommit": false,
    "autoPR": false,
    "safetyChecks": true
  },
  "database": {
    "enabled": false,
    "defaultType": "sqlite",
    "autoMigrate": true
  },
  "plugins": {
    "enabled": true,
    "directory": "plugins",
    "autoLoad": true
  },
  "integrations": {
    "slack": {
      "enabled": false
    },
    "discord": {
      "enabled": false
    },
    "jira": {
      "enabled": false
    },
    "trello": {
      "enabled": false
    }
  }
}